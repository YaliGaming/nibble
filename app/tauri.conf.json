{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nibble",
  "version": "1.0.0",
  "identifier": "io.github.yaligaming.nibble",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "copyright": "Copyright (c) 2026 Nibble contributors",
    "shortDescription": "A desktop pet for Claude Code",
    "resources": {
      "../target/release/nibble-hook.exe": "nibble-hook.exe"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh",
        "languages": ["English", "Hebrew"]
      }
    }
  }
}
